rules_version = '2';

// =============================================================
// MS FÚTBOL SCOUT · Reglas de seguridad de Cloud Firestore
// -------------------------------------------------------------
// Principio: NADIE lee ni escribe sin (1) sesión iniciada y
// (2) su correo en la lista blanca configuracion/acceso.emails.
//
// La lista blanca se edita SOLO desde la consola de Firebase
// (Firestore → configuracion → acceso → campo "emails", array de
// correos en minúsculas). Ningún cliente puede modificarla.
//
// Las colecciones se enumeran una a una: un permiso en bloque
// («cualquier colección») dejaría que una cuenta comprometida
// creara colecciones nuevas fuera de la copia de seguridad, y
// nada en el servidor frenaría documentos con forma imposible.
//
// Despliegue:  npx firebase-tools deploy --only firestore:rules
// ATENCIÓN: publicar estas reglas cierra la aplicación a quien no
// tenga cuenta. Van DESPUÉS de crear las cuentas (ver RUNBOOK).
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Exigir el correo VERIFICADO es defensa en profundidad: si alguien reactivase el registro
    // público en la consola, no bastaría con registrarse con un correo que esté en la lista blanca.
    function conSesion() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 0
        && request.auth.token.email_verified == true;
    }

    function listaBlanca() {
      return get(/databases/$(database)/documents/configuracion/acceso).data.emails;
    }

    function autorizado() {
      return conSesion()
        && exists(/databases/$(database)/documents/configuracion/acceso)
        && listaBlanca() is list
        && request.auth.token.email.lower() in listaBlanca();
    }

    // Guarda de FORMA, no de bytes: en las reglas, data.size() cuenta CAMPOS (el peso en bytes
    // no se puede medir aquí). Un documento con más de 200 campos no es de esta aplicación. El
    // límite de 1 MiB lo aplica Firestore por su cuenta, y la aplicación mide antes de enviar.
    function tamanoRazonable() {
      return request.resource == null || request.resource.data.size() <= 200;
    }

    // Lista blanca: ni lectura ni escritura desde la app. Las reglas la consultan con get() sin
    // necesitar permiso del cliente, así que dar lectura solo serviría para exponer los correos
    // del equipo a cualquier usuario autorizado (minimización, art. 5.1.c RGPD).
    match /configuracion/acceso {
      allow read, write: if false;
    }

    // Interruptor de la puerta de acceso (configuracion/puerta, campo activada). Se crea desde la
    // consola al terminar la activación. Con estas reglas publicadas, la aplicación ya no puede
    // leerlo sin sesión, y eso es justo lo que la hace cerrar la puerta: coherente.
    match /configuracion/puerta {
      allow read: if autorizado();
      allow write: if false;
    }

    // Resto de documentos de configuración (app_settings).
    match /configuracion/{docId} {
      allow read, write: if autorizado() && docId != 'acceso' && docId != 'puerta';
    }

    // Las diecinueve colecciones de datos de la aplicación, una a una. Cualquier otra queda
    // denegada por defecto.
    match /jugadores/{docId}             { allow read, write: if autorizado() && tamanoRazonable(); }
    match /clubes/{docId}                { allow read, write: if autorizado() && tamanoRazonable(); }
    match /equipos/{docId}               { allow read, write: if autorizado() && tamanoRazonable(); }
    match /federaciones/{docId}          { allow read, write: if autorizado() && tamanoRazonable(); }
    match /selecciones/{docId}           { allow read, write: if autorizado() && tamanoRazonable(); }
    match /convocatorias/{docId}         { allow read, write: if autorizado() && tamanoRazonable(); }
    match /torneos/{docId}               { allow read, write: if autorizado() && tamanoRazonable(); }
    match /staff/{docId}                 { allow read, write: if autorizado() && tamanoRazonable(); }
    match /agencias/{docId}              { allow read, write: if autorizado() && tamanoRazonable(); }
    match /agentes/{docId}               { allow read, write: if autorizado() && tamanoRazonable(); }
    match /estadios/{docId}              { allow read, write: if autorizado() && tamanoRazonable(); }
    match /partidos/{docId}              { allow read, write: if autorizado() && tamanoRazonable(); }
    match /informes/{docId}              { allow read, write: if autorizado() && tamanoRazonable(); }
    match /agenda/{docId}                { allow read, write: if autorizado() && tamanoRazonable(); }
    match /agendaCategories/{docId}      { allow read, write: if autorizado() && tamanoRazonable(); }
    match /enlaces/{docId}               { allow read, write: if autorizado() && tamanoRazonable(); }
    match /cartelera_calendarios/{docId} { allow read, write: if autorizado() && tamanoRazonable(); }
    match /notas_categorias/{docId}      { allow read, write: if autorizado() && tamanoRazonable(); }
    match /notas_fichas/{docId}          { allow read, write: if autorizado() && tamanoRazonable(); }

    // Las subcolecciones no se usan: quedan denegadas por defecto.
  }
}
